{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "locate": {
      "description": "Find the files to edit for an issue; never edits.",
      "mode": "primary",
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "external_directory": "deny"
      }
    }
  },
  "provider": {
    "refuseless": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Refuseless",
      "options": {
        "baseURL": "https://api.refuseless.com/v1"
      },
      "models": {
        "deepseek-v4.1-flash-fast": {
          "name": "deepseek-v4.1-flash-fast",
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    }
  }
}